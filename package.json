{
  "name": "flexible-portfolio-card",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build-prod": "ng build --configuration production",
    "build-dev-watch": "ng build --watch --configuration development",
    "test": "ng test",
    "s3-upload-dev": "aws s3 sync ./dist/flexible-portfolio-card s3://REDACTED_S3_BUCKET --delete --profile REDACTED_AWS_PROFILE",
    "cloudfront-invalidation-dev": "aws cloudfront create-invalidation --distribution-id REDACTED_CF_DISTRIBUTION_ID --paths \"/*\" --profile REDACTED_AWS_PROFILE",
    "deploy-dev": "npm run build-prod && npm run s3-upload-dev && npm run cloudfront-invalidation-dev",
    "deploy-prod": "npm run build-prod && ng deploy"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.12",
    "@angular/cdk": "~14.2.7",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.2.12",
    "@angular/core": "^14.3.0",
    "@angular/fire": "^7.6.1",
    "@angular/forms": "^14.2.12",
    "@angular/material": "^14.2.7",
    "@angular/platform-browser": "^14.2.12",
    "@angular/platform-browser-dynamic": "^14.2.12",
    "@angular/router": "^14.2.12",
    "@types/gsap": "^3.0.0",
    "angularx-qrcode": "^14.0.0",
    "autosize": "^6.0.0",
    "browser-image-compression": "^2.0.0",
    "crypto-js": "^4.1.1",
    "cupertino-pane": "^1.3.2",
    "eslint": "^8.33.0",
    "gsap": "^3.11.4",
    "lottie-web": "^5.10.2",
    "ngx-autosize-input": "^14.1.0",
    "ngx-lottie": "^8.3.0",
    "overlayscrollbars-ngx": "^0.4.0",
    "rxjs": "~7.5.0",
    "swiper": "^9.4.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.10",
    "@angular/cli": "~14.2.10",
    "@angular/compiler-cli": "^14.2.12",
    "@types/jasmine": "~4.3.1",
    "jasmine-core": "~4.5.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "overlayscrollbars": "^2.2.1",
    "prettier": "^2.8.3",
    "typescript": "~4.7.2"
  }
}
